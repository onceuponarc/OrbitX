NEXT_PUBLIC_SUPABASE_URL=https://YOUR_ONCEUPON_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Used by `pnpm sql:apply`. Direct db.*.supabase.co:5432 is IPv6-only from some hosts;
# the script uses the session-mode pooler (aws-0-…pooler.supabase.com:5432).
SUPABASE_DB_PASSWORD=
# Optional override. Defaults to the session-mode pooler when PROJECT_REF + DB_PASSWORD are set.
# SUPABASE_POOLER_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43147
# Production site: https://once-upon-arc.vercel.app
# Leftover Solana RPC for old Story URLs only. OnceUpon prints on Arc.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional extra entropy for embedded-wallet encryption. Falls back to the service role.
EMBEDDED_WALLET_SECRET=
# Optional IPFS pin so coin art is an ipfs:// CID (Pinata JWT or NFT.Storage token).
# Without this, covers are stored in the public Supabase `covers` bucket.
PINATA_JWT=
# NFT_STORAGE_TOKEN=

# Arc Devnet (Anvil). pnpm arc:devnet writes data/arc-devnet.json.
# ARC_RPC_URL=http://127.0.0.1:8546
# ARC_CHAIN_ID=31337
# ARC_USDC=
# ARC_DEV_PRIVATE_KEY=
